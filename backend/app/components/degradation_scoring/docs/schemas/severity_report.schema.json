{
  "$defs": {
    "AuditSummary": {
      "properties": {
        "claims_contradicted": {
          "minimum": 0,
          "title": "Claims Contradicted",
          "type": "integer"
        },
        "claims_grounded": {
          "minimum": 0,
          "title": "Claims Grounded",
          "type": "integer"
        },
        "claims_total": {
          "minimum": 0,
          "title": "Claims Total",
          "type": "integer"
        },
        "claims_unsupported": {
          "minimum": 0,
          "title": "Claims Unsupported",
          "type": "integer"
        },
        "flagged": {
          "items": {
            "type": "string"
          },
          "title": "Flagged",
          "type": "array"
        },
        "groundedness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Groundedness",
          "type": "number"
        }
      },
      "required": [
        "claims_total",
        "claims_grounded",
        "claims_unsupported",
        "claims_contradicted",
        "groundedness"
      ],
      "title": "AuditSummary",
      "type": "object"
    },
    "ContextTag": {
      "enum": [
        "GENUINE",
        "INTENTIONAL",
        "UNCERTAIN"
      ],
      "title": "ContextTag",
      "type": "string"
    },
    "DataProvenance": {
      "enum": [
        "fixture",
        "fixture-events+live-history",
        "live"
      ],
      "title": "DataProvenance",
      "type": "string"
    },
    "Dimension": {
      "enum": [
        "blast_radius",
        "hotspot",
        "adr_violation",
        "persistence"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "DimensionScore": {
      "properties": {
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        },
        "features": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Features",
          "type": "object"
        },
        "normalized": {
          "maximum": 1,
          "minimum": 0,
          "title": "Normalized",
          "type": "number"
        },
        "raw": {
          "title": "Raw",
          "type": "number"
        },
        "weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "raw",
        "normalized",
        "weight"
      ],
      "title": "DimensionScore",
      "type": "object"
    },
    "EvidenceItem": {
      "properties": {
        "id": {
          "pattern": "^E[1-9]\\d*$",
          "title": "Id",
          "type": "string"
        },
        "provenance": {
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "text",
        "provenance"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "EvidenceSource": {
      "enum": [
        "metric",
        "subgraph",
        "cochange",
        "adr",
        "commit"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "NormalizationBounds": {
      "properties": {
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "NormalizationBounds",
      "type": "object"
    },
    "NormalizationMode": {
      "enum": [
        "robust_minmax",
        "minmax_small_n"
      ],
      "title": "NormalizationMode",
      "type": "string"
    },
    "QuarantineReason": {
      "enum": [
        "malformed_payload",
        "unresolved_element"
      ],
      "title": "QuarantineReason",
      "type": "string"
    },
    "QuarantinedEvent": {
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "reason": {
          "$ref": "#/$defs/QuarantineReason"
        }
      },
      "required": [
        "reason"
      ],
      "title": "QuarantinedEvent",
      "type": "object"
    },
    "Resolution": {
      "properties": {
        "confidence": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Confidence",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/ResolutionStatus"
        }
      },
      "required": [
        "status",
        "confidence"
      ],
      "title": "Resolution",
      "type": "object"
    },
    "ResolutionStatus": {
      "enum": [
        "exact",
        "prefix_fallback"
      ],
      "title": "ResolutionStatus",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "PENDING",
        "CONFIRMED",
        "REJECTED",
        "NEEDS_INVESTIGATION"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "Scope": {
      "enum": [
        "ELEMENT",
        "INSTANCE",
        "SYSTEM"
      ],
      "title": "Scope",
      "type": "string"
    },
    "SeverityRecord": {
      "properties": {
        "anti_pattern_type": {
          "minLength": 1,
          "title": "Anti Pattern Type",
          "type": "string"
        },
        "audit": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context_tag": {
          "$ref": "#/$defs/ContextTag"
        },
        "contributions": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/Dimension"
          },
          "title": "Contributions",
          "type": "object"
        },
        "dimensions": {
          "additionalProperties": {
            "$ref": "#/$defs/DimensionScore"
          },
          "propertyNames": {
            "$ref": "#/$defs/Dimension"
          },
          "title": "Dimensions",
          "type": "object"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Evidence",
          "type": "array"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "resolution": {
          "$ref": "#/$defs/Resolution"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "severity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Severity",
          "type": "number"
        }
      },
      "required": [
        "event_id",
        "anti_pattern_type",
        "scope",
        "review_status",
        "context_tag",
        "rank",
        "severity",
        "dimensions",
        "contributions",
        "resolution"
      ],
      "title": "SeverityRecord",
      "type": "object"
    },
    "SkipReason": {
      "enum": [
        "not_confirmed",
        "rejected",
        "intentional",
        "system_scope_not_rankable",
        "superseded"
      ],
      "title": "SkipReason",
      "type": "string"
    },
    "SkippedEvent": {
      "properties": {
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/SkipReason"
        }
      },
      "required": [
        "event_id",
        "reason"
      ],
      "title": "SkippedEvent",
      "type": "object"
    },
    "WeightsProvenance": {
      "enum": [
        "provisional-author-elicited",
        "supervisor-elicited"
      ],
      "title": "WeightsProvenance",
      "type": "string"
    }
  },
  "properties": {
    "active_dimensions": {
      "items": {
        "$ref": "#/$defs/Dimension"
      },
      "minItems": 1,
      "title": "Active Dimensions",
      "type": "array"
    },
    "ahp_cr": {
      "minimum": 0,
      "title": "Ahp Cr",
      "type": "number"
    },
    "data_provenance": {
      "$ref": "#/$defs/DataProvenance"
    },
    "normalization": {
      "$ref": "#/$defs/NormalizationMode"
    },
    "normalization_bounds": {
      "additionalProperties": {
        "$ref": "#/$defs/NormalizationBounds"
      },
      "title": "Normalization Bounds",
      "type": "object"
    },
    "quarantined": {
      "items": {
        "$ref": "#/$defs/QuarantinedEvent"
      },
      "title": "Quarantined",
      "type": "array"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/SeverityRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "release_id": {
      "minLength": 1,
      "title": "Release Id",
      "type": "string"
    },
    "resolution_rate": {
      "maximum": 1,
      "minimum": 0,
      "title": "Resolution Rate",
      "type": "number"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1.0",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "skipped": {
      "items": {
        "$ref": "#/$defs/SkippedEvent"
      },
      "title": "Skipped",
      "type": "array"
    },
    "system_id": {
      "minLength": 1,
      "title": "System Id",
      "type": "string"
    },
    "weights_provenance": {
      "$ref": "#/$defs/WeightsProvenance"
    },
    "weights_version": {
      "minLength": 1,
      "title": "Weights Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "system_id",
    "release_id",
    "data_provenance",
    "active_dimensions",
    "weights_version",
    "weights_provenance",
    "ahp_cr",
    "normalization",
    "resolution_rate"
  ],
  "title": "SeverityReportV1",
  "type": "object"
}
