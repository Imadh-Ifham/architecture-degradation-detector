# Secrets and environment-specific configuration.
#
# Non-sensitive tuning values live in config.ini, which is committed, so they do
# not need an entry here. Everything set in this file overrides config.ini, so
# use it for anything that differs between machines or environments.
#
# Copy to `.env` and fill in:  cp .env.example .env

# Environment ---------------------------------------------------------------
APP_ENV=development
# APP_NAME=Architecture Degradation Detector

# PostgreSQL ----------------------------------------------------------------
POSTGRES_HOST=localhost
# Host port published by docker-compose.yml (5434, to avoid the native
# Windows PostgreSQL service that occupies 5432).
POSTGRES_PORT=5434
POSTGRES_DB=architecture_degradation
POSTGRES_USER=architecture
POSTGRES_PASSWORD=

# Neo4j ---------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=

# Workspace -----------------------------------------------------------------
# Absolute path where ingested (cloned) repositories are kept. Leave empty to use
# <system temp>/add-repositories.
REPOSITORIES_ROOT=
# Where degradation scoring (C4) writes run outputs. Defaults to
# backend/artifacts/scoring (git-ignored); uncomment to put them elsewhere.
# SCORING_OUTPUTS_ROOT=

# Model access --------------------------------------------------------------
# The validation component reaches a model through an OpenAI-compatible
# endpoint, so the provider is a URL and a key rather than a vendor SDK. Both
# default to a free, open-weights provider; only the key is a secret.
#
# Without a key the component still runs: the two stages that call a model
# report themselves as unable to and the run is reported incomplete, which is
# the honest outcome rather than a crash. The `live` test marker is skipped.
AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_REASONER_MODEL=openai/gpt-oss-20b
# AI_VERIFIER_MODEL=qwen/qwen3.8-27b
# The reasoner's two fallbacks, tried only when nothing answered. The second
# needs a local runtime, so leave it unless one is installed.
# AI_FALLBACK_MODEL=openai/gpt-oss-120b
# AI_LOCAL_MODEL=llama3.2:3b
# The local runtime's endpoint. Unset means there is no local runtime, and the
# rung that would use it reports itself unavailable instead of sending a local
# model name to the hosted provider. Set it after installing one.
# AI_LOCAL_BASE_URL=http://localhost:11434/v1
# Whether a verdict may be produced by the deterministic table alone, when no
# model could be reached at all. Leave it on for a demonstration, where that
# is the rollback. Turn it off for any run whose numbers get reported: without
# a key every governed fact degrades to the table, and a figure drawn from
# that run would describe the table while reading as describing a model.
# AI_ALLOW_ARBITER_ONLY=true
