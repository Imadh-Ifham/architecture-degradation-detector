APP_NAME=Architecture Degradation Detector
APP_ENV=development

POSTGRES_HOST=
# Host port published by docker-compose.yml (5434, to avoid the native
# Windows PostgreSQL service that occupies 5432).
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Optional. Where ingested (cloned) repositories are kept; defaults to
# <system temp>/add-repositories when unset. Leave commented out to use the default.
# REPOSITORIES_ROOT=
GIT_CLONE_TIMEOUT_SECONDS=300

# Repository inventory limits. See repository_inventory/ for details.
INVENTORY_MAX_FILES=20000
INVENTORY_MAX_FILE_SIZE_BYTES=5000000
INVENTORY_MAX_DEPTH=32
INVENTORY_MAX_MANIFEST_BYTES=262144
INVENTORY_GROUPING_DEPTH=2
# Extra directory names to exclude from an inventory, comma-separated.
INVENTORY_EXTRA_EXCLUDED_DIRECTORIES=

# Manifest analysis limits. Only files the inventory classified as deployment
# manifests or API specifications are parsed.
MANIFEST_ANALYSIS_MAX_BYTES=1048576
MANIFEST_ANALYSIS_MAX_DOCUMENTS=64